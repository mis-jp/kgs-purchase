# Copy to .env on the production server (never commit real .env).
# Required for login and Acumatica sync.

# Public app URL — PRODUCTION ONLY (leave unset for local npm run dev)
NEXT_PUBLIC_BASE_PATH=/kgs-purchase
# Production public URL (browser). For server-local auto-sync, also set:
# NEXT_PUBLIC_BASE_URL=http://localhost:3001/kgs-purchase
NEXT_PUBLIC_BASE_URL=http://190.92.233.232

# Acumatica ERP
ACUMATICA_BASE_URL=https://your-acumatica-host.example.com/ERP
ACUMATICA_COMPANY=KGSC
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=

# Emergency bypass (optional — used when API login limit is hit)
ACU_USERNAME=
ACU_PASSWORD=

# Local app admin seed (optional — defaults shown)
# APP_ADMIN_USERNAME=admin
# APP_ADMIN_PASSWORD=KelinAdmin#2026

# MySQL — use 127.0.0.1 when MySQL runs on the same server as the app
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_INVENTORY_DATABASE=db_kelin_inventory
MYSQL_PURCHASE_DATABASE=db_purchase

# Product Directory admin mutations (optional). If set, Flutter/admin must send:
#   X-Inventory-Admin-Token: <same value>
INVENTORY_ADMIN_TOKEN=

# Sync API
SYNC_SECRET=

# Supabase (if used)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# R&D Management dedicated database (never point this at purchase/inventory schemas for writes)
MYSQL_RD_DATABASE=db_rd_management
# RD_ADMIN_EMAIL=johnpaulpolendey22@gmail.com
# RD_ADMIN_PASSWORD=
# RD_ADMIN_NAME=John Paul Polendey

